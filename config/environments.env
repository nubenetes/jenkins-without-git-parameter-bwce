# ==============================================================================
# Enterprise TIBCO BWCE GitOps Platform: Environment & Endpoint Configurations
# Architecture: GitOps Pull Model (ArgoCD 3.5 + Lean Jenkins Multibranch CI)
# ==============================================================================

PLATFORM_DOMAIN="apps.ocp-dev.nubenetes.internal"
PLATFORM_NAMESPACE_JENKINS="jenkins"
PLATFORM_NAMESPACE_ARGOCD="argocd"
PLATFORM_NAMESPACE_DATADOG="datadog"

# Workload Namespaces for TIBCO BWCE
NAMESPACE_DEV="nubenetes-dev-bwce"
NAMESPACE_STAGING="nubenetes-staging-bwce"
NAMESPACE_PROD="nubenetes-prod-bwce"

# Git Repositories
GITOPS_REPO_URL="https://github.com/nubenetes/jenkins-without-git-parameter-bwce.git"
APP_BWCE_ORDER_REPO="https://github.com/nubenetes/tibco-bwce-order-service.git"
APP_BWCE_CUSTOMER_REPO="https://github.com/nubenetes/tibco-bwce-customer-api.git"

# OpenShift Container Registries
DEV_REGISTRY="image-registry.openshift-image-registry.svc:5000/nubenetes-dev-bwce"
STAGING_REGISTRY="image-registry.openshift-image-registry.svc:5000/nubenetes-staging-bwce"
PROD_REGISTRY="image-registry.openshift-image-registry.svc:5000/nubenetes-prod-bwce"

# TIBCO BWCE Runtime Base Image
BWCE_BASE_IMAGE="tibco/bwce:2.9.2"

# ArgoCD 3.5 Endpoints
ARGOCD_SERVER_URL="https://argocd-server.apps.ocp-dev.nubenetes.internal"
ARGOCD_SERVER_GRPC="argocd-server.argocd.svc.cluster.local:443"

# Datadog Observability
DATADOG_SITE="datadoghq.com"
DATADOG_AGENT_HOST="datadog-agent.datadog.svc.cluster.local"
